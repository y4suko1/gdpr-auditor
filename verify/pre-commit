#!/usr/bin/env python3
"""
Pre-commit hook: refuses a commit that changes a file under reference/
without checksums.sha256 also being staged in the same commit.

Install by copying this file to .git/hooks/pre-commit (no extension) and
making it executable. This lives in verify/ rather than .git/hooks/ because
git hooks aren't tracked by git itself, so this copy is how the check
travels with the repo instead of being lost on a fresh clone.

This does not verify the checksums are correct, only that they were
regenerated (verify/regenerate_checksums.py) as part of the same commit
that changed reference/. A stale checksums.sha256 committed alongside a
real reference/ change would still pass this hook; it exists to catch the
much more common mistake of forgetting to regenerate it at all.
"""

import subprocess
import sys


def staged_files():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only"],
        capture_output=True, text=True, check=True,
    )
    return result.stdout.splitlines()


def main():
    files = staged_files()
    reference_changed = [f for f in files if f.startswith("reference/") and f != "reference/checksums.sha256"]
    checksums_changed = "reference/checksums.sha256" in files

    if reference_changed and not checksums_changed:
        print("Commit blocked: reference/ files changed but checksums.sha256 was not updated.")
        print("Changed files:")
        for f in reference_changed:
            print(f"  {f}")
        print()
        print("Run: python verify/regenerate_checksums.py")
        print("Then stage checksums.sha256 (and update the date in reference/index.md) before committing.")
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
